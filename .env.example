# Sanity
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=
SANITY_REVALIDATE_SECRET=
# 1 = serve the bundled demo content instead of Sanity (always 1 in CI and e2e).
# Also used automatically when NEXT_PUBLIC_SANITY_PROJECT_ID is empty.
CONTENT_MOCK=0

# Gemini (free tier)
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# 1 = deterministic fixtures, no API calls (always 1 in CI)
AI_MOCK=0

# Admin (basic auth for /admin and /api/admin)
ADMIN_USER=admin
ADMIN_PASSWORD=

# Integrations
CRM_ADAPTER=mock

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3002
